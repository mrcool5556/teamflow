# Teamflow server environment. Every variable the server reads is listed here with its default.
# The server loads this file itself at startup: TEAMFLOW_ENV_FILE if set, else `.env` in the app
# folder (repo root) if it exists. Variables already set in the process environment win.
# Invalid values (e.g. PORT=abc) stop the server with a list of problems.

# ---------- Server ----------
PORT=3000
HOST=0.0.0.0
DATABASE_URL=file:./data/teamflow.db
# NODE_ENV=production            # production: no localhost dev origins in CORS
# NODE_ENV=development           # development: allows the insecure dev secret, logs reset links

# Required. Long random value (16+ chars), e.g. `openssl rand -hex 32`. The server refuses to
# start while it is unset, short or a placeholder like the one below, unless NODE_ENV=development
# or TEAMFLOW_ALLOW_DEV_SECRET=1 (local development only).
JWT_SECRET=change-me-in-production-use-long-random-string
# TEAMFLOW_ALLOW_DEV_SECRET=1

# Encrypts the Discord bot token/PAT saved in Settings (falls back to JWT_SECRET if unset).
# Same rules as JWT_SECRET: placeholders are refused. Keys are scrypt-derived.
TEAMFLOW_SECRETS_KEY=
# Shared with the Discord bot so it can fetch its credentials; generated and written here
# automatically when an instance admin saves bot credentials in the web UI.
TEAMFLOW_BOT_CONFIG_KEY=

# The address people open; used for invite and reset links and always allowed by CORS.
PUBLIC_URL=http://localhost:3000
# Extra browser origins allowed to call the API (comma-separated). Outside production
# localhost:5173-5179 is allowed too. Default: PUBLIC_URL only.
# CORS_ORIGINS=https://teamflow.example.com
# Serve the built web UI from the API port (the installers set it). It is also on when
# NODE_ENV=production and the build exists. WEB_DIST defaults to apps/web/dist.
# SERVE_WEB=true
# WEB_DIST=apps/web/dist
# Load a different env file instead of this one.
# TEAMFLOW_ENV_FILE=/path/to/teamflow.env

# ---------- Accounts ----------
# The first account registered becomes the instance admin (server admin page, updates, Discord
# bot secrets). These emails get the flag too, at their next login or registration.
# TEAMFLOW_INSTANCE_ADMINS=you@example.com,other@example.com
# Registration only through an invite link.
# TEAMFLOW_INVITE_ONLY=true
# Login/register/forgot-password attempts per minute per IP (default 10).
# TEAMFLOW_AUTH_RATE_LIMIT=10
# Set to 1 only behind a reverse proxy, so X-Forwarded-For is used as the client IP.
# TEAMFLOW_TRUST_PROXY=1

# ---------- Password reset email (optional) ----------
# Without SMTP, reset links are only written to the server log when NODE_ENV=development;
# in production nobody can reset a password.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false              # true for port 465 (also implied by SMTP_PORT=465)
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=teamflow@example.com

# ---------- Uploads (optional) ----------
# Stored under data/uploads/ (UPLOAD_DIR, relative to the repo root, moves it).
# Per-file limits, default 4 GB each.
# UPLOAD_DIR=data/uploads
# ATTACHMENT_MAX_IMAGE_BYTES=4294967296
# ATTACHMENT_MAX_VIDEO_BYTES=4294967296
# ATTACHMENT_MAX_ZIP_BYTES=4294967296
# ATTACHMENT_MAX_BYTES=4294967296
# UPLOAD_CHUNK_BYTES=33554432          # 32 MB chunks
# UPLOAD_CHUNK_THRESHOLD_BYTES=8388608 # files over 8 MB upload in chunks
# Team bundle import caps (entries / total uncompressed bytes, default 2 GB).
# TEAMFLOW_BUNDLE_MAX_ENTRIES=5000
# TEAMFLOW_BUNDLE_MAX_BYTES=2147483648

# ---------- Spaces (docs/SPACES.md) ----------
# Server admin → Space defaults overrides these once saved.
# TEAMFLOW_FREE_SPACE_CAP_BYTES=1073741824   # upload cap of a new free space (1 GB)
# TEAMFLOW_FREE_SPACES_PER_USER=3            # free spaces one account may own, General included
# TEAMFLOW_MIN_FREE_DISK_BYTES=2147483648    # pause all uploads under this much free disk; 0 = off

# ---------- In-app backups & updates (Linux, Setup B) ----------
# Server admin → Updates (and Settings → Updates). Needs an instance admin and a one-time
# `sudo bash deploy/proxmox-lxc/setup-maintenance-sudo.sh`.
# TEAMFLOW_MAINTENANCE_ENABLED=true
# TEAMFLOW_MAINTENANCE_SUDO=true             # default true
# TEAMFLOW_APP_DIR=/opt/teamflow             # default: the repo root
# TEAMFLOW_BACKUP_DIR=/var/backups/teamflow  # default /var/backups/teamflow
# Leave the script overrides unset: by default the server uses the root-owned copies in
# /usr/local/lib/teamflow/, the only paths sudoers allows. Pointing them at the checkout
# (deploy/proxmox-lxc/*.sh) makes every sudo call fail.
# TEAMFLOW_BACKUP_SCRIPT=
# TEAMFLOW_UPDATE_SCRIPT=
# TEAMFLOW_DISCORD_BOT_SCRIPT=

# ---------- Data upkeep (optional) ----------
# Nightly at 03:00: purge trash older than 7 days, repair Owner roles, renumber duplicate issue
# numbers. Off by default; run it by hand with `pnpm db:maintenance`.
# TEAMFLOW_DB_MAINTENANCE_NIGHTLY=true

# ---------- Not read by the server ----------
# Demo data for `pnpm db:seed` / `pnpm db:setup` (demo@teamflow.local / changeme123).
# Never in production.
# TEAMFLOW_SEED_DEMO=1
# The web app, MCP and CLI do not read this file: Vite always proxies /api to localhost:3000
# in development, MCP takes TEAMFLOW_URL / TEAMFLOW_TOKEN from its client config (docs/MCP.md),
# and the CLI stores its URL and token with `teamflow login` (docs/CLI.md).

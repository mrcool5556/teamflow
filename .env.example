# Server
PORT=3000
HOST=0.0.0.0
DATABASE_URL=file:./data/teamflow.db
# Required. Long random value, e.g. `openssl rand -hex 32`. The server refuses to start while
# this is unset or still a placeholder (set NODE_ENV=development only for local work).
JWT_SECRET=change-me-in-production-use-long-random-string
# Encrypts Discord bot token/PAT saved in Settings (falls back to JWT_SECRET if unset).
# Same rules as JWT_SECRET: placeholders are refused. Keys are scrypt-derived.
TEAMFLOW_SECRETS_KEY=
# Shared with apps/discord-bot/.env so the bot can fetch credentials from the API
TEAMFLOW_BOT_CONFIG_KEY=
PUBLIC_URL=http://localhost:3000
# Browser origins allowed to call the API (comma-separated). PUBLIC_URL is always allowed;
# outside production localhost:5173-5179 is allowed too. Default: same-origin only.
# CORS_ORIGINS=https://teamflow.example.com
# Login/register/forgot-password attempts per minute per IP (default 10).
# TEAMFLOW_AUTH_RATE_LIMIT=10
# Set to 1 only behind a reverse proxy, so X-Forwarded-For is used as the client IP.
# TEAMFLOW_TRUST_PROXY=1
# Team bundle import caps (entries / total uncompressed bytes).
# TEAMFLOW_BUNDLE_MAX_ENTRIES=5000
# TEAMFLOW_BUNDLE_MAX_BYTES=2147483648

# Optional — password reset emails (if unset, reset links are logged on the server)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=teamflow@example.com

# Optional — issue file uploads (stored under data/uploads/)
# Defaults are 4 GB for images, videos, ZIPs, and other files.
# ATTACHMENT_MAX_IMAGE_BYTES=4294967296
# ATTACHMENT_MAX_VIDEO_BYTES=4294967296
# ATTACHMENT_MAX_ZIP_BYTES=4294967296
# ATTACHMENT_MAX_BYTES=4294967296
# UPLOAD_CHUNK_BYTES=33554432
# UPLOAD_CHUNK_THRESHOLD_BYTES=8388608

# Optional — in-app backups & updates (Settings → Updates, Owner permission)
# TEAMFLOW_MAINTENANCE_ENABLED=true
# TEAMFLOW_APP_DIR=/opt/teamflow
# TEAMFLOW_BACKUP_DIR=/var/backups/teamflow
# TEAMFLOW_BACKUP_SCRIPT=/opt/teamflow/deploy/proxmox-lxc/backup.sh
# TEAMFLOW_UPDATE_SCRIPT=/opt/teamflow/deploy/proxmox-lxc/update.sh
# TEAMFLOW_MAINTENANCE_SUDO=true

# Web dev (Vite proxy target)
VITE_API_URL=http://localhost:3000

# MCP / CLI
TEAMFLOW_URL=http://localhost:3000
TEAMFLOW_TOKEN=

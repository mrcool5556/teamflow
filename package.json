{
  "name": "teamflow",
  "version": "0.1.0",
  "description": "Self-hosted team issue tracker with MCP and CLI for AI assistants",
  "scripts": {
    "dev": "pnpm --parallel -r --filter @teamflow/server --filter @teamflow/web dev",
    "dev:discord": "pnpm --filter @teamflow/discord-bot dev",
    "build": "pnpm -r build",
    "db:generate": "pnpm --filter @teamflow/db generate",
    "db:migrate": "pnpm --filter @teamflow/db migrate",
    "db:seed": "pnpm --filter @teamflow/db seed",
    "db:maintenance": "pnpm --filter @teamflow/db maintenance",
    "db:setup": "pnpm db:migrate && pnpm db:seed",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "docs:api": "node scripts/gen-api-docs.mjs",
    "docs:api:check": "node scripts/gen-api-docs.mjs --check"
  },
  "engines": {
    "node": "20.x"
  },
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}

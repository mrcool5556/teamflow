PORT=3000
HOST=0.0.0.0
DATABASE_URL=file:./data/teamflow.db
# Required. Long random value, e.g. PowerShell: -join ((1..32) | % { '{0:x2}' -f (Get-Random -Max 256) })
# The server refuses to start while this is unset or still a placeholder.
JWT_SECRET=change-me-to-a-long-random-string
WEB_DIST=apps/web/dist

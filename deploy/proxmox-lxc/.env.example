# Teamflow on Proxmox LXC (Setup B). install.sh copies this to /opt/teamflow/.env.
# systemd loads it (EnvironmentFile) and the server reads it too. After editing:
#   chmod 600 /opt/teamflow/.env && systemctl restart teamflow
# Full list of variables: the root .env.example and docs/SELF-HOSTING.md.

PORT=3000
HOST=0.0.0.0
DATABASE_URL=file:./data/teamflow.db
NODE_ENV=production

# Required. Long random value, e.g. `openssl rand -hex 32`. The service refuses to start while
# this is unset, under 16 characters or still a placeholder.
JWT_SECRET=change-me-to-a-long-random-string
# Recommended: a second random value that encrypts Discord bot secrets (falls back to JWT_SECRET).
# TEAMFLOW_SECRETS_KEY=

# The address people open (invite and reset links; the allowed browser origin).
PUBLIC_URL=http://localhost:3000
# CORS_ORIGINS=https://other-origin.example.com
# Behind Caddy / nginx / Cloudflare:
# TEAMFLOW_TRUST_PROXY=1

# The first registered account becomes the instance admin; these emails get it at next login.
# TEAMFLOW_INSTANCE_ADMINS=you@example.com
# TEAMFLOW_INVITE_ONLY=true

SERVE_WEB=true
WEB_DIST=/opt/teamflow/apps/web/dist

# In-app backups & updates (Server admin → Updates & backups). Needs an instance admin and a one-time
# `sudo bash /opt/teamflow/deploy/proxmox-lxc/setup-maintenance-sudo.sh`.
# Do not set TEAMFLOW_BACKUP_SCRIPT / TEAMFLOW_UPDATE_SCRIPT / TEAMFLOW_DISCORD_BOT_SCRIPT:
# the defaults are the root-owned copies in /usr/local/lib/teamflow/ that sudoers allows.
TEAMFLOW_MAINTENANCE_ENABLED=true
TEAMFLOW_APP_DIR=/opt/teamflow
TEAMFLOW_BACKUP_DIR=/var/backups/teamflow
TEAMFLOW_MAINTENANCE_SUDO=true

# Trash purge and data upkeep every night at 03:00 (otherwise run `pnpm db:maintenance`).
# TEAMFLOW_DB_MAINTENANCE_NIGHTLY=true

# Discord bot service (Server admin → Discord bot / Settings → Integrations).
# TEAMFLOW_BOT_CONFIG_KEY is generated and appended here when credentials are saved in the UI.

# Password reset emails: run `sudo teamflow-smtp`, or set these. Without SMTP nobody can reset
# a password in production.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=teamflow@example.com

# Optional — per-file upload limits (default 4 GB each)
# ATTACHMENT_MAX_IMAGE_BYTES=4294967296
# ATTACHMENT_MAX_VIDEO_BYTES=4294967296
# ATTACHMENT_MAX_ZIP_BYTES=4294967296
# ATTACHMENT_MAX_BYTES=4294967296

# Spaces (docs/SPACES.md). Server admin → Space defaults overrides these once saved.
# TEAMFLOW_FREE_SPACE_CAP_BYTES=1073741824   # upload cap of a new free space (1 GB)
# TEAMFLOW_FREE_SPACES_PER_USER=3            # free spaces one account may own, General included
# TEAMFLOW_MIN_FREE_DISK_BYTES=2147483648    # pause all uploads under this much free disk; 0 = off

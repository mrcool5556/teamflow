# Keep 3000: this value is both the published host port and the in-container port.
# To publish elsewhere, edit the left side of `ports:` in docker-compose.yml instead.
PORT=3000
# Required. Long random value, e.g. `openssl rand -hex 32`. The server refuses to start while
# this is unset or still a placeholder.
JWT_SECRET=change-me-to-a-long-random-string
PUBLIC_URL=http://localhost:3000
# TEAMFLOW_INVITE_ONLY=true

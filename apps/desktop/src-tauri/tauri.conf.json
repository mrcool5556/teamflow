{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Teamflow",
  "version": "0.2.1",
  "identifier": "app.teamflow.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Teamflow",
        "url": "index.html",
        "width": 1280,
        "height": 820,
        "minWidth": 380,
        "minHeight": 520,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Teamflow",
    "shortDescription": "Teamflow issue tracker",
    "longDescription": "Runs the Teamflow server on this PC with a window and a tray icon. Others on your network open it in a browser.",
    "copyright": "Teamflow",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/release.zip": "release.zip",
      "resources/node/node.exe": "node/node.exe"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
